# Stream service / player
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_VIEW_URL=
# Optional external HLS playlist. Leave blank to use this app's /hls/stream.m3u8.
HLS_PLAYBACK_URL=

# Capture: auto selects PipeWire for a Wayland session, otherwise X11.
CAPTURE_BACKEND=auto
X11_DISPLAY=
X11_OFFSET=+0,0
PIPEWIRE_SOURCE=0

# Video-only capture and H.264 encoding
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_BITRATE=4500k
VIDEO_ENCODER=libx264

# RTMP ingest credential (not an account login token). Keep it out of source control and chat.
RTMP_INGEST_URL=rtmp://localhost/live
STREAM_KEY=

# Local HLS files and reconnect behavior
HLS_OUTPUT_DIR=./var/hls
RECONNECT_BASE_SECONDS=2
RECONNECT_MAX_SECONDS=30

# screen1 and screen2 are normal Discord user IDs, not tokens. They do not log the users in.
SCREEN1_DISCORD_USER_ID=
SCREEN2_DISCORD_USER_ID=

# Discord bot login token (bot identity only, not either participant's account token).
DISCORD_BOT_TOKEN=
# Optional extra bot admins. These IDs can run all bot commands.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
